{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "ai_drama.api:app",
        "--port",
        "8080"
      ],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "envFile": "${workspaceFolder}/backend/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src"
      },
      "jinja": true,
      "justMyCode": false
    },
    {
      "name": "Frontend: Vite",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev -- --port 3000",
      "cwd": "${workspaceFolder}/frontend",
      "env": {
        "VITE_API_BASE_URL": "http://127.0.0.1:8080",
        "VITE_GENERATION_CHANNEL": "routin"
      }
    }
  ],
  "compounds": [
    {
      "name": "Full stack: Backend + Frontend + Browser",
      "configurations": [
        "Backend: FastAPI",
        "Frontend: Vite",
      ],
      "stopAll": true
    }
  ]
}
